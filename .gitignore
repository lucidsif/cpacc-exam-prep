# Local runtime state (server writes this on missed-question updates)
data.json

# macOS
.DS_Store

# Editor/tooling
.vscode/
.idea/
*.swp

# Node (none used yet, but in case)
node_modules/

# Backups created when patching external files (e.g., Bear DB)
*.backup-*

# Cloudflare Pages deploy staging
dist/

# Wrangler local session/cache state (written by `wrangler pages dev`)
.wrangler/

# Playwright output (traces, screenshots, HTML/blob reports) — regenerated
# by every `npm run test:e2e` run, not something to commit. Note: this does
# NOT ignore e2e/ itself, only what Playwright writes as a byproduct.
test-results/
playwright-report/
blob-report/

# Copyrighted reference material — not ours to redistribute.
# CPACC_BoK.pdf (the IAAP Body of Knowledge PDF) lives on the author's disk
# at the repo root for local reference when writing/verifying question
# citations, but its license doesn't permit redistribution, so it must
# never be committed. Ignoring any root-level PDF, not just this filename,
# because future reference material (other IAAP/vendor docs) would carry
# the same copyright restriction.
/*.pdf
